# Credenciais de uma conta de serviço Atlassian com acesso ao Jira e às equipes.
# Configure estes valores no painel do servidor; não salve o token no repositório.
ATLASSIAN_EMAIL=conta-de-servico@ccee.org.br
ATLASSIAN_API_TOKEN=

# Identificadores da organização e da equipe autorizada para o dashboard.
ATLASSIAN_ORG_ID=ba61jb15-96bb-1kc7-ka88-k642k4jk16k3
ATLASSIAN_CLOUD_ID=dc84ad47-68dd-4be9-bc55-b820b2ab48b1
ATLASSIAN_TEAM_IDS=7b3408c8-0503-49fa-b416-805600221ba4
ATLASSIAN_JIRA_SITE=https://centraldeservicosccee.atlassian.net

# Em hospedagens com disco efêmero, aponte ambos para um volume persistente.
JIRA_SNAPSHOT_PATH=/dados/jira_snapshot.duckdb
ATLASSIAN_TEAM_CACHE_PATH=/dados/team_members_cache.json
